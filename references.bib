@article{nunez_multi-scale_2019,
	title = {Multi-{Scale} {Neural} {Sources} of {EEG}: {Genuine}, {Equivalent}, and {Representative}. {A} {Tutorial} {Review}},
	volume = {32},
	issn = {1573-6792},
	shorttitle = {Multi-{Scale} {Neural} {Sources} of {EEG}},
	url = {https://doi.org/10.1007/s10548-019-00701-3},
	doi = {10.1007/s10548-019-00701-3},
	abstract = {A biophysical framework needed to interpret electrophysiological data recorded at multiple spatial scales of brain tissue is developed. Micro current sources at membrane surfaces produce local field potentials, electrocorticography, and electroencephalography (EEG). We categorize multi-scale sources as genuine, equivalent, or representative. Genuine sources occur at the micro scale of cell surfaces. Equivalent sources provide identical experimental outcomes over a range of scales and applications. In contrast, each representative source distribution is just one of many possible source distributions that yield similar experimental outcomes. Macro sources (“dipoles”) may be defined at the macrocolumn (mm) scale and depend on several features of the micro sources—magnitudes, micro synchrony within columns, and distribution through the cortical depths. These micro source properties are determined by brain dynamics and the columnar structure of cortical tissue. The number of representative sources underlying EEG data depends on the spatial scale of neural tissue under study. EEG inverse solutions (e.g. dipole localization) and high resolution estimates (e.g. Laplacian, dura imaging) have both strengths and limitations that depend on experimental conditions. The proposed theoretical framework informs studies of EEG source localization, source characterization, and low pass filtering. It also facilitates interpretations of brain dynamics and cognition, including measures of synchrony, functional connections between cortical locations, and other aspects of brain complexity.},
	language = {en},
	number = {2},
	urldate = {2026-01-07},
	journal = {Brain Topography},
	author = {Nunez, Paul L. and Nunez, Michael D. and Srinivasan, Ramesh},
	month = mar,
	year = {2019},
	keywords = {Dipole localization, EEG, Laplacian, Sources, Spatial scale, Synchronization},
	pages = {193--214},
	file = {Full Text PDF:/home/nino/Zotero/storage/AIVU9FXC/Nunez et al. - 2019 - Multi-Scale Neural Sources of EEG Genuine, Equivalent, and Representative. A Tutorial Review.pdf:application/pdf},
}

