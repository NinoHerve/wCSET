	url = {https://www.sciencedirect.com/science/article/pii/S1053811918301046},
	doi = {10.1016/j.neuroimage.2018.02.016},
	abstract = {We mathematically derive a simple relationship between structural connectivity, measured via diffusion tensor imaging, and functional connectivity, measured via resting-state fMRI, whereby the two are related via the graph Laplacian's spectrum: functional and structural connectivity share eigenvectors, and their eigenvalues are related via an approximately exponential mapping, so that a small number of low-frequency structural eigenmodes dominate the reconstruction of empirical functional connectivity.},
